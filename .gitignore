node_modules/
.env
dist/
*.log
.DS_Store

# Android (Capacitor) — build.gradle/AndroidManifest.xml etc are tracked; local machine
# artifacts and build output are not.
client/android/local.properties
client/android/.gradle/
client/android/**/build/
client/android/captures/
client/android/.cxx/
client/android/.idea/
*.apk
*.aab
*.keystore
*.jks

# iOS (Capacitor) — Xcode project files are tracked; CocoaPods output, user-specific
# workspace state, and signing material are not (Pods/ regenerates from Podfile.lock via
# `pod install`, which needs to run on a Mac anyway).
client/ios/App/Pods/
client/ios/**/xcuserdata/
client/ios/**/*.xcuserstate
client/ios/DerivedData/
*.mobileprovision
*.p12
*.cer
