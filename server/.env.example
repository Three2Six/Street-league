DATABASE_URL=postgres://user:password@localhost:5432/street_league
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# One-time-payment paywall (server/src/routes/billing.js) — leave unset in dev to skip payments
# entirely (checkout returns 503); the 3-day free trial still works either way.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional global override (server/src/access.js): while now() is before this ISO timestamp,
# EVERY user has full access regardless of their individual trial/paid status — use this to run
# a beta where the whole cohort locks down together instead of on staggered per-signup timers.
# Remove the var (or let it pass) to fall back to normal per-user trial/paid gating.
BETA_ENDS_AT=
